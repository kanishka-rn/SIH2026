# Copy to .env locally. Never commit real values.

# Application
APP_ENV=development

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Supabase (names only — fill locally from the dashboard, never commit keys)
# Public API URL shape: https://<project-ref>.supabase.co
SUPABASE_URL=
SUPABASE_PROJECT_REF=
# Recommended client key: sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=
# Recommended server key: sb_secret_...  Never send this to the browser.
SUPABASE_SECRET_KEY=
# Legacy JWT keys (compatibility through 2026). Prefer publishable/secret keys.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI if used later. Never commit.
DATABASE_URL=

# LLM providers (unused until AI/explanation phases)
OPENROUTER_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Embeddings (unused until semantic retrieval)
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
